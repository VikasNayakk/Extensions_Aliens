{
  "manifest_version": 3,
  "name": "Voice Speakers — Aliens",
  "version": "1.3.0",
  "description": "Reads ChatGPT replies aloud and announces new incoming Microsoft Teams chat messages with the sender's name.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://api.openai.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.microsoft.com/*"
  ],
  "action": {
    "default_title": "Voice Speakers"
  },
  "background": {
    "service_worker": "service.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
