{
  "manifest_version": 3,
  "name": "Voice Speakers — Aliens",
  "version": "1.0.1",
  "description": "Turns selected team-chat messages into accurate, speaker-attributed spoken summaries.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "activeTab", "clipboardRead"],
  "host_permissions": ["https://api.openai.com/*"],
  "action": {
    "default_title": "Voice Speakers",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}