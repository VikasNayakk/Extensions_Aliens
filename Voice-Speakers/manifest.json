{
  "manifest_version": 3,
  "name": "Voice Speakers — Aliens",
  "version": "1.5.8",
  "description": "Priority-based Microsoft Teams group monitor with last-five history reading and live announcements.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "tts",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://api.openai.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.microsoft.com/*"
  ],
  "action": {
    "default_title": "Voice Speakers",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://teams.cloud.microsoft/*",
        "https://teams.microsoft.com/*"
      ],
      "js": [
        "teams-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
