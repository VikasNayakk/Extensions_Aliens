{
  "manifest_version": 3,
  "name": "Voice Speakers — Aliens",
  "version": "1.0.0",
  "description": "Turns selected team-chat messages into accurate, speaker-attributed spoken summaries.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting", "clipboardRead"],
  "host_permissions": ["https://api.openai.com/*"],
  "action": {
    "default_title": "Voice Speakers",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}